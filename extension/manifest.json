{
  "manifest_version": 3,
  "name": "e-SUS PEC - Extensão de Inquérito",
  "version": "1.3.0",
  "description": "Ativa automaticamente no e-SUS PEC para realizar inquéritos telefónicos.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inquérito e-SUS PEC"
  }
}